{
  "name": "opencode-agent-manager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1",
  "type": "module",
  "scripts": {
    "build": "bun run tsc -p tsconfig.json",
    "install-plugin": "mkdir -p .opencode/plugins/agent-manager-built && rsync -a dist/ .opencode/plugins/agent-manager-built/",
    "deploy-plugin": "mkdir -p .opencode/plugins/agent-manager && rsync -a dist/ .opencode/plugins/agent-manager/",
    "test": "sh -c 'find test -name \"*.test.ts\" -print0 | xargs -0 -n1 tsx'",
    "smoke": "sh -c 'tsx test/smoke.test.ts'",
    "e2e": "sh -c 'tsx test/e2e.test.ts'",
    "lint": "tsx --help"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.3",
    "comment-json": "^4.2.0"
  },
  "devDependencies": {
    "tsx": "^4.9.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  }
}

{
  "name": "opencode-agent-manager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1",
  "type": "module",
  "scripts": {
    "build": "bun run tsc -p tsconfig.json",
    "deploy-plugin": "mkdir -p .opencode/plugins/agent-manager && rsync -a dist/ .opencode/plugins/agent-manager/",
    "install-plugin": "bun run build && bun run deploy-plugin",
    "test": "bun test test/*.test.ts",
    "smoke": "bun test test/smoke.test.ts",
    "e2e": "bun test test/e2e.test.ts",
    "lint": "bun --help"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.7",
    "comment-json": "^4.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "bun-types": "^1.3.12",
    "typescript": "^5.5.0"
  }
}
